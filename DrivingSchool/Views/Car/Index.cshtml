@model IEnumerable<DrivingSchool.ViewModels.Car.IndexVM>

@{
    ViewData["Title"] = "Cars";
}

<h1>Cars</h1>

<p>
    <a asp-action="Create">Create new car</a>
</p>

<form asp-controller="Car" asp-action="Index" method="get">

    <div class="row mb-3">

        <div class="col-md-2">
            <label class="form-label">Brand</label>
            <input type="text"
                   name="brand"
                   value="@ViewBag.Brand"
                   class="form-control"
                   placeholder="Search by brand..." />
        </div>

        <div class="col-md-2">
            <label class="form-label">Model</label>
            <input type="text"
                   name="model"
                   value="@ViewBag.Model"
                   class="form-control"
                   placeholder="Search by model..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Minimum Year</label>
            <input type="number"
                   name="minYear"
                   value="@ViewBag.MinYear"
                   min="1885"
                   max="2026"
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Sort By</label>

            <select name="sortOrder" class="form-control">
                <option value="brand_asc"
                        selected="@(ViewBag.SortOrder == "brand_asc")">
                    Brand A-Z
                </option>
                <option value="brand_desc"
                        selected="@(ViewBag.SortOrder == "brand_desc")">
                    Brand Z-A
                </option>
                <option value="year_asc"
                        selected="@(ViewBag.SortOrder == "year_asc")">
                    Year Ascending
                </option>
                <option value="year_desc"
                        selected="@(ViewBag.SortOrder == "year_desc")">
                    Year Descending
                </option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>

    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Brand)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Model)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LicensePlate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DrivingInstructorName)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var car in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => car.Brand)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => car.Model)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => car.LicensePlate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => car.DrivingInstructorName)
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@car.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@car.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@car.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>