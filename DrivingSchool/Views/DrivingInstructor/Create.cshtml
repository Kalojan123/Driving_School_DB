@using Driving_School_DB.Enums
@model DrivingSchool.ViewModels.DrivingInstructor.CreateVM

<h1>Register a driving instructor</h1>

<form asp-action="Create" method="post">

    <label>Name:</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <br />
    <br />

    <label>Email:</label>
    <input asp-for="Email" />
    <span asp-validation-for="Email"></span>

    <br />
    <br />

    <label>Phone number:</label>
    <input asp-for="PhoneNumber" />
    <span asp-validation-for="PhoneNumber"></span>

    <br />
    <br />

    <label>Address:</label>
    <input asp-for="Address" />
    <span asp-validation-for="Address"></span>

    <br />
    <br />

    <label>Category:</label>
    <select asp-for="Category" asp-items="Html.GetEnumSelectList<Categories>()" class="form-control">
        <option value="">-- Select category --</option>
    </select>
    <span asp-validation-for="Category"></span>

    <br />
    <br />

    <button type="submit" class="btn btn-primary">Submit</button>
</form>
<a asp-action="Index">Back to list</a>

<br />

<a href="/DrivingInstructor/Index">Show all driving instructors</a>
