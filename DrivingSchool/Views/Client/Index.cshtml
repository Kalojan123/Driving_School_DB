@model IEnumerable<DrivingSchool.ViewModels.Client.IndexVM>

@{
    ViewData["Title"] = "Client";
}

<h1>Clients</h1>

<p>
    <a asp-action="Create">Create new client</a>
</p>

<div class="row mb-3">

    <div class="col-md-3">
        <label>Client Name</label>
        <input type="text" id="search"
               class="form-control"
               placeholder="Search by name..." />
    </div>

    <div class="col-md-3">
        <label>Driving Instructor</label>
        <input type="text" id="drivingInstructor"
               class="form-control"
               placeholder="Enter driving instructor..." />
    </div>

    <div class="col-md-3">
        <label>Sort By</label>
        <select id="sortOrder" class="form-control">
            <option value="name_asc">Name A-Z</option>
            <option value="name_desc">Name Z-A</option>
            <option value="drivingInstructor">Driving Instructor A-Z</option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="button" id="clearFilters"
                class="btn btn-secondary">
            Clear Filters
        </button>
    </div>

</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DrivingInstructor)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody id="clientsTable">
        @foreach (var client in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem =>client.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => client.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => client.DrivingInstructor)
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@client.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@client.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@client.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="/js/ClientFilter.js"
            asp-append-version="true">
    </script>
}